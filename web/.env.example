# Copy to `.env` for local dev. Astro exposes only `PUBLIC_*` to the client bundle.

# Self-serve purchase is gated by ISO instants in `src/lib/programs.ts` (`AIMA_5001_PURCHASE_AVAILABLE_FROM_ISO`
# for Simple; `AIMA_5001_ADVANCED_PURCHASE_AVAILABLE_FROM_ISO` for Advanced — LTI + subscription stack).
# Build compares wall-clock at `astro build` — redeploy after each open date.

# --- AIMA5001 Simple ($1,500) — Stripe Payment Link ---
# In Stripe Dashboard: Product (one-time price $1,500 USD) → Payment Links → create link.
# Under "After payment", set "Don't show confirmation page" OR redirect to:
#   https://programs.castalia.institute/purchase/aima-basic/success/
# Paste the Payment Link URL here so the site shows "Buy Simple" CTAs. (Env name keeps AIMA_BASIC for Stripe compatibility.)
# PUBLIC_STRIPE_PAYMENT_LINK_AIMA_BASIC=https://buy.stripe.com/...
# Optional alias:
# PUBLIC_STRIPE_PAYMENT_LINK_BASIC=

# Optional: other Stripe links (Advanced / enterprise SKUs) — shows an extra card on /purchase
# PUBLIC_CASTALIA_PURCHASE_CHECKOUT_URL=
# PUBLIC_CASTALIA_STRIPE_CHECKOUT_URL=

# Optional: one Stripe Payment Link per catalog course code (Buy on /catalog and /catalog/courses/*).
# Example: PUBLIC_STRIPE_PAYMENT_LINK_AINS6001=https://buy.stripe.com/...
# AIMA5001: Simple → PUBLIC_STRIPE_PAYMENT_LINK_AIMA5001Simple=...

# More Human Than Human certificate — public program site (catalog links MHH5001 here by default)
# PUBLIC_MHTH_URL=https://mhth.castalia.institute
# Optional aliases: PUBLIC_MHH_URL=  PUBLIC_MHTH_CERTIFICATE_URL=

# Castalia Moodle (demos + live delivery). Standard course URL shape:
#   {PUBLIC_CASTALIA_LMS_URL}/course/view.php?id=<numeric_course_id>
PUBLIC_CASTALIA_LMS_URL=https://lms.castalia.institute

# Optional: one URL per AIMA5001 SKU — full Moodle URL wins over numeric id below.
# If both unset, catalog/demo CTAs open the LMS home. Simple/Advanced fall back to legacy per-line env keys when unset.
# PUBLIC_CASTALIA_LMS_AIMA_SIMPLE_URL=
# PUBLIC_CASTALIA_LMS_AIMA_ADVANCED_URL=
# Legacy (used as fallbacks for Simple → Basic/Classroom; Advanced → Dialogic/AI Delivery):
# PUBLIC_CASTALIA_LMS_AIMA_BASIC_URL=
# PUBLIC_CASTALIA_LMS_AIMA_CLASSROOM_URL=
# PUBLIC_CASTALIA_LMS_AIMA_AI_DELIVERY_URL=
# PUBLIC_CASTALIA_LMS_AIMA_DIALOGIC_URL=

# Optional: Moodle numeric course id per AIMA SKU (builds /course/view.php?id= on PUBLIC_CASTALIA_LMS_URL).
# PUBLIC_CASTALIA_MOODLE_COURSE_ID_AIMA_SIMPLE=
# PUBLIC_CASTALIA_MOODLE_COURSE_ID_AIMA_ADVANCED=
# Legacy fallbacks (same as URL list above):
# PUBLIC_CASTALIA_MOODLE_COURSE_ID_AIMA_BASIC=
# PUBLIC_CASTALIA_MOODLE_COURSE_ID_AIMA_CLASSROOM=
# PUBLIC_CASTALIA_MOODLE_COURSE_ID_AIMA_AI_DELIVERY=
# PUBLIC_CASTALIA_MOODLE_COURSE_ID_AIMA_DIALOGIC=

# Optional: per-catalog-course links (used by /catalog/courses/* + catalog LMS column).
# Precedence: explicit full URL, then numeric id (digits only), else LMS home.
# Full URL: PUBLIC_CASTALIA_LMS_<CODE> where <CODE> is the course code with non-alphanumerics stripped
#   (e.g. AINS6001, AIMA5001Simple for "AIMA5001: Simple").
# Example: PUBLIC_CASTALIA_LMS_AINS6001=https://lms.castalia.institute/course/view.php?id=42
# Numeric id (same URL builder): PUBLIC_CASTALIA_MOODLE_COURSE_ID_AINS6001=42
# PUBLIC_CASTALIA_LMS_AINS6002=

# AIMA certificate (AINS5001 — A Modern Approach to AI). Prefer the Moodle program/course URL for the certificate:
# PUBLIC_CASTALIA_LMS_AIMA_CERTIFICATE_URL=https://lms.castalia.institute/course/view.php?id=...
# Alias: PUBLIC_CASTALIA_LMS_AINS5001=

# MHH certificate — optional dedicated Moodle shell (default outbound link is PUBLIC_MHTH_URL / mhth.castalia.institute)
# PUBLIC_CASTALIA_LMS_MHH5001=
