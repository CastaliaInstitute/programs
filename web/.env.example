# Copy to `.env` for local dev. Astro exposes only `PUBLIC_*` to the client bundle.

# Self-serve purchase is gated by ISO instants in `src/lib/programs.ts` (`AIMA_5001_PURCHASE_AVAILABLE_FROM_ISO`
# for Basic / Classroom / SAMWISE / BEATRICE; `AIMA_5001_MEDIA_PURCHASE_AVAILABLE_FROM_ISO` for AI Delivery + Dialogic).
# Build compares wall-clock at `astro build` — redeploy after each open date.

# --- AIMA5001 Basic ($1,500) — Stripe Payment Link ---
# In Stripe Dashboard: Product (one-time price $1,500 USD) → Payment Links → create link.
# Under "After payment", set "Don't show confirmation page" OR redirect to:
#   https://programs.castalia.institute/purchase/aima-basic/success/
# Paste the Payment Link URL here so the site shows "Buy Basic" CTAs.
# PUBLIC_STRIPE_PAYMENT_LINK_AIMA_BASIC=https://buy.stripe.com/...
# Optional alias:
# PUBLIC_STRIPE_PAYMENT_LINK_BASIC=

# Optional: other Stripe links (non-Basic SKUs) — shows an extra card on /purchase
# PUBLIC_CASTALIA_PURCHASE_CHECKOUT_URL=
# PUBLIC_CASTALIA_STRIPE_CHECKOUT_URL=

# Castalia Moodle (demos + live delivery)
PUBLIC_CASTALIA_LMS_URL=https://lms.castalia.institute

# Optional: one URL per AIMA5001 variant — Moodle course or activity deep links (guest-visible demos).
# If unset, "Castalia LMS (demo)" opens the LMS home.
# PUBLIC_CASTALIA_LMS_AIMA_BASIC_URL=
# PUBLIC_CASTALIA_LMS_AIMA_AI_DELIVERY_URL=
# PUBLIC_CASTALIA_LMS_AIMA_CLASSROOM_URL=
# PUBLIC_CASTALIA_LMS_AIMA_DIALOGIC_URL=
# PUBLIC_CASTALIA_LMS_AIMA_SAMWISE_URL=
# PUBLIC_CASTALIA_LMS_AIMA_BEATRICE_URL=

# Optional: per-AINS course deep links on lms.castalia.institute (used by /catalog/courses/* pages + catalog LMS column).
# Example: PUBLIC_CASTALIA_LMS_AINS6001=https://lms.castalia.institute/course/view.php?id=...
# PUBLIC_CASTALIA_LMS_AINS6002=

# AIMA certificate (AINS5001 — A Modern Approach to AI). Prefer the Moodle program/course URL for the certificate:
# PUBLIC_CASTALIA_LMS_AIMA_CERTIFICATE_URL=https://lms.castalia.institute/course/view.php?id=...
# Alias: PUBLIC_CASTALIA_LMS_AINS5001=
