---
import BaseLayout from '../layouts/BaseLayout.astro'
import { aima5001SelfServePurchaseIsOpen } from '../lib/purchase-gate'
import {
  AIMA_BASIC_PRICE_USD,
  CASTALIA_LMS_URL,
  resolveStripePaymentLinkAimaBasic,
} from '../lib/site-links'

const aimaBasicStripe = resolveStripePaymentLinkAimaBasic()
const aimaSalesOpen = aima5001SelfServePurchaseIsOpen()
---

<BaseLayout
  title="Castalia Programs"
  description="License Castalia graduate AI courses, certificates, and AIMA 5001 products for your institutional catalog."
  isHomePage={true}
>
  <main class="programs-page">
    <section class="hero">
      <div class="hero__inner">
        <span class="eyebrow">AI Curriculum Available for Licensing</span>
        <h1>Graduate AI courses for your catalog—without writing everything from zero.</h1>
        <p>
          The catalog centers on licensable <strong>AINS</strong> graduate courses: a reference core sequence,
          specialization clusters in healthcare, business, cybersecurity, and robotics AI, a capstone, and a stackable
          Sovereign AI certificate (AINS6010)—your institution names the program and sets credentials. AIMA 5001 (graduate AI
          foundations / AI problem solving) is listed separately with PDF samples, IMS Common Cartridges, and GitHub
          delivery demos.
        </p>
        <div class="hero__actions">
          {aimaSalesOpen ? (
            <a
              class="button button--primary"
              href={aimaBasicStripe ?? '/purchase#aima-basic'}
            >
              {`Buy AIMA Simple — $${AIMA_BASIC_PRICE_USD.toLocaleString('en-US')}`}
            </a>
          ) : (
            <span class="button button--secondary" style="cursor: default; opacity: 0.9;">
              AIMA Simple — not for sale until release (Apr 15, 2026 target)
            </span>
          )}
          <a class="button button--secondary" href="/catalog">Explore the catalog</a>
          <a class="button button--ghost" href="/purchase">All purchase options</a>
          <a class="button button--ghost" href="/institutions">Institution partnerships</a>
          <a
            class="button button--ghost"
            href={CASTALIA_LMS_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Castalia LMS
          </a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section__intro">
        <h2>Built for institutional procurement</h2>
        <p>
          This site is designed for deans, provosts, online learning leaders, and academic
          entrepreneurs evaluating whether the curriculum fits their institution, launch
          timeline, staffing model, and enrollment strategy.
        </p>
      </div>
      <div class="grid grid--cards">
        <article class="card">
          <h3>Clear academic value</h3>
          <p>Present a coherent AI curriculum with core foundations, applied specializations, and a capstone aligned to workforce demand.</p>
        </article>
        <article class="card">
          <h3>Operational readiness</h3>
          <p>Show how a fully online program can be launched, staffed, adapted, and supported inside an institutional delivery model.</p>
        </article>
        <article class="card">
          <h3>Commercial clarity</h3>
          <p>Frame the curriculum for degree launch, specialization pilots, or certificate extensions with clear partnership structures.</p>
        </article>
      </div>
    </section>

    <section class="section">
      <div class="section__intro">
        <h2>What institutions can buy</h2>
        <p>
          The same course set can support a full graduate degree your institution names, a specialization-first
          pilot, or stackable certificates that extend an existing catalog.
        </p>
      </div>
      <div class="grid grid--cards">
        <article class="card">
          <h3>Full course stack</h3>
          <p>License the reference core, capstone, and specialization clusters as a coherent graduate AI sequence your registrar can map to local requirements.</p>
        </article>
        <article class="card">
          <h3>Specialization pathways</h3>
          <p>Start with healthcare, business, cybersecurity, or robotics AI as a market-facing concentration or pilot pathway.</p>
        </article>
        <article class="card">
          <h3>Certificate expansion</h3>
          <p>Use Sovereign AI (AINS6010) and related courses to build applied certificate inventory for technical learners.</p>
        </article>
      </div>
    </section>

    <section class="section">
      <div class="section__intro">
        <h2>What each program page includes</h2>
        <p>
          Every listing is written so your team can evaluate fit quickly: curriculum scope,
          academic positioning, how delivery can work on your campus, and what each specialization
          delivers for students.
        </p>
      </div>
      <ul class="list">
        <li>Program structure, total credit hours, core curriculum, and specialization pathways.</li>
        <li>Delivery model, online implementation assumptions, and faculty or student support expectations.</li>
        <li>Licensing structure for full-program launch, certificate packaging, or concentration pilots.</li>
        <li>Review artifacts such as course descriptions, syllabi, capstone framing, and launch planning materials.</li>
      </ul>
    </section>

    <section class="cta">
      <h2>Ready to add graduate AI courses?</h2>
      <p>
        Browse the catalog, purchase where self-serve is available, or start an institutional conversation about which
        courses to license, how they stack, and implementation support.
      </p>
      <div class="hero__actions" style="justify-content: center; margin-top: 1.25rem;">
        {aimaSalesOpen ? (
          <a
            class="button button--primary"
            href={aimaBasicStripe ?? '/purchase#aima-basic'}
          >
            {`Buy AIMA Simple — $${AIMA_BASIC_PRICE_USD.toLocaleString('en-US')}`}
          </a>
        ) : (
          <span class="button button--secondary" style="cursor: default;">
            Sales open after course release
          </span>
        )}
        <a class="button button--secondary" href="/catalog">Browse the curriculum</a>
      </div>
    </section>
  </main>
</BaseLayout>
