---
import BaseLayout from '../../layouts/BaseLayout.astro'
import AimaVariantCatalogTable from '../../components/AimaVariantCatalogTable.astro'
import PopuliDemoShell from '../../components/PopuliDemoShell.astro'
import { aimaProductRouteSlug } from '../../lib/catalog-courses'
import { AIMA_REPO, IMSCC_VIEWER_PATH, programOfferings } from '../../lib/programs'
import { aima5001SelfServePurchaseIsOpen, isPurchaseAvailableFrom } from '../../lib/purchase-gate'
import {
  AIMA_BASIC_PRICE_USD,
  castaliaLmsAimaDemoUrl,
  resolveStripePaymentLinkAimaBasic,
} from '../../lib/site-links'

const aimaBasicStripe = resolveStripePaymentLinkAimaBasic()
const aimaSalesOpen = aima5001SelfServePurchaseIsOpen()

const program = programOfferings.find((p) => p.slug === 'aima')
if (!program || !program.deliverableDemos) {
  throw new Error('AIMA offering or demos missing from programs data')
}
---

<BaseLayout
  title="AIMA 5001 — AIMA product demos"
  description="AIMA 5001 graduate course products—Simple (lectures + GitHub instructor/student repos) and Advanced (full AI stack, LTI, subscription)—with live demos, IMS Common Cartridge where applicable, and links into the AIMA repository."
>
  <main class="programs-page" style="padding-top: 0.5rem;">
    <PopuliDemoShell
      courseCode="AIMA 5001"
      courseTitle="AIMA (Using AI to Make AI)"
      pillLabel="AIMA5001: Simple & Advanced"
    >
      <section class="populi-demo__panel">
        <div class="populi-demo__panel-head">
          <h2 class="populi-demo__panel-title">Notifications</h2>
          <button type="button" class="populi-demo__icon-btn" aria-label="Notifications menu" disabled>⋮</button>
        </div>
        <p class="populi-demo__panel-body populi-demo__panel-body--empty">
          You have no notifications for this course.
        </p>
      </section>

      <section class="populi-demo__panel">
        <div class="populi-demo__panel-head">
          <h2 class="populi-demo__panel-title">Bulletin Board</h2>
          <button type="button" class="populi-demo__icon-btn" aria-label="Bulletin menu" disabled>⋮</button>
        </div>
        <div class="populi-demo__composer">
          <textarea
            class="populi-demo__textarea"
            rows="3"
            placeholder="Share something with the class…"
            disabled
          />
          <div class="populi-demo__composer-foot">
            <span style="color: var(--populi-text-muted);">Formatting guide</span>
            <button type="button" class="populi-demo__btn populi-demo__btn--primary" disabled>Post</button>
          </div>
        </div>
        <p class="populi-demo__panel-body" style="margin-top: 0.85rem;">
          Preview-only shell—posts are not saved on this demo site.
        </p>
      </section>

      <p class="populi-demo__intro">{program.summary}</p>

      <div class="populi-demo__actions">
        {aimaSalesOpen ? (
          <a
            class="populi-demo__btn populi-demo__btn--primary"
            href={aimaBasicStripe ?? '/purchase#aima-basic'}
          >
            {`Buy Simple — $${AIMA_BASIC_PRICE_USD.toLocaleString('en-US')}`}
          </a>
        ) : (
          <span class="populi-demo__btn populi-demo__btn--ghost" style="cursor: default; opacity: 0.85;">
            Not for sale yet ({program.deliverableDemos[0]?.statusExpected ?? 'see Status'})
          </span>
        )}
        <a class="populi-demo__btn populi-demo__btn--ghost" href="/purchase">
          Purchase hub
        </a>
        <a class="populi-demo__btn populi-demo__btn--ghost" href={AIMA_REPO}>Open course repository</a>
        <a class="populi-demo__btn populi-demo__btn--ghost" href={IMSCC_VIEWER_PATH}>IMS CC viewer</a>
        <a class="populi-demo__btn populi-demo__btn--ghost" href="/catalog">Programs catalog</a>
      </div>

      <h2 class="populi-demo__section-title" style="margin-top: 2rem;">Two AIMA5001 products</h2>
      <p class="populi-demo__intro">
        Each row is a <strong>separate licensable SKU</strong> on the same AIMA 5001 graduate spine. <strong>Simple</strong> is
        lectures plus the creation and release of the GitHub course repository (instructor and student repos via Classroom).
        <strong>Advanced</strong> adds the full AI stack, LTI integration, and a Castalia subscription.
      </p>

      <p class="populi-demo__at-a-glance" id="aima5001-course-lines">
        <span class="populi-demo__at-a-glance-label">At a glance</span>
        {
          program.deliverableDemos.map((demo) => (
            <span class="populi-demo__course-chip">{demo.courseCode}</span>
          ))
        }
      </p>

      <h2 class="populi-demo__section-title" style="margin-top: 1.5rem;">Feature matrix</h2>
      <p class="populi-demo__intro">
        ✓ means the variant ships that asset or workflow as part of the product line; — means it is not the focus of
        that SKU. IMS CC cells link to the per-variant <code class="purchase-code">.imscc</code> when included.
      </p>
      <div class="aima-matrix-wrap">
        <AimaVariantCatalogTable demos={program.deliverableDemos} aimaBasicStripe={aimaBasicStripe} />
      </div>

      <ul class="demo-list" aria-labelledby="aima5001-course-lines">
        {
          program.deliverableDemos.map((demo) => (
            <li class="demo-list__item card">
              <h3 class="demo-list__title">
                <span class="course-variant__code">{demo.courseCode}</span>
              </h3>
              <p class="demo-list__summary">{demo.summary}</p>
              <p class="demo-list__status">
                <strong>Status</strong>
                {' · '}
                {demo.statusExpected}
              </p>
              <div class="demo-list__actions">
                {isPurchaseAvailableFrom(demo.purchaseAvailableFrom) ? (
                  demo.lmsVariant === 'simple' ? (
                    <a
                      class="button button--primary"
                      href={aimaBasicStripe ?? '/purchase#aima-basic'}
                    >
                      {`Buy — $${AIMA_BASIC_PRICE_USD.toLocaleString('en-US')}`}
                    </a>
                  ) : (
                    <a class="button button--primary" href="/purchase">
                      Purchase
                    </a>
                  )
                ) : (
                  <span class="button button--secondary" style="pointer-events: none; opacity: 0.75;">
                    Not for sale yet
                  </span>
                )}
                <a
                  class={`button ${isPurchaseAvailableFrom(demo.purchaseAvailableFrom) ? 'button--secondary' : 'button--primary'}`}
                  href={demo.primaryHref}
                >
                  {demo.primaryLabel}
                </a>
                {demo.secondaryHref && demo.secondaryLabel && (
                  <a class="button button--secondary" href={demo.secondaryHref}>
                    {demo.secondaryLabel}
                  </a>
                )}
                {demo.tertiaryHref && demo.tertiaryLabel && (
                  <a class="button button--secondary" href={demo.tertiaryHref}>
                    {demo.tertiaryLabel}
                  </a>
                )}
                {demo.imsccHref && (
                  <a class="button button--secondary" href={demo.imsccHref}>
                    Download IMS CC (.imscc)
                  </a>
                )}
                <a
                  class="button button--secondary"
                  href={castaliaLmsAimaDemoUrl(demo.lmsVariant)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Castalia LMS (demo)
                </a>
                <a
                  class="button button--secondary"
                  href={`/catalog/courses/${aimaProductRouteSlug(demo.courseCode)}`}
                >
                  Syllabus & overview
                </a>
              </div>
            </li>
          ))
        }
      </ul>

      <h2 class="populi-demo__section-title" style="margin-top: 2rem;">Implementation notes</h2>
      <ul class="list">
        <li>
          Course demos: engineering still builds variant pages from <code>web/demo-sources/ain2001/</code> (one{' '}
          <code>.md</code> file per legacy demo name). <code>npm run build:demos</code> runs the static build once and copies
          output to <code>public/demos/course/ain2001/</code>; the catalog exposes two buyer SKUs (Simple and Advanced).
        </li>
        <li>
          Per-deliverable GitHub repos (Populi-style Pages): run <code>npm run scaffold:aima-repos</code> in{' '}
          <code>web/</code> to generate e.g. <code>aima-basic</code>, <code>aima-delivery</code>—each with the same LMS chrome
          as this page, built to <code>dist/</code> for GitHub Actions → GitHub Pages.
        </li>
        <li>
          Classroom / Codespaces: <code>npm run scaffold:aima-codespace</code> materializes the{' '}
          <code>aima-codespace</code> template (devcontainer, pytest exercises, CI) under{' '}
          <code>.aima-variant-repos/</code> for publishing as <code>CastaliaInstitute/aima-codespace</code>. Students fork
          and rename to <code>aima-&lt;username&gt;</code>.
        </li>
        <li>
          PDFs and IMS CC: run <code>npm run build:demos</code> in <code>web/</code> before <code>astro build</code> so PDFs
          from <code>demos/aima-demo-content/</code> land in <code>public/demos/</code>, the full-course MyST cartridge is
          written to <code>public/demos/aima-lms-demo.imscc</code>, each variant gets its own{' '}
          <code>aima-*-lms-demo.imscc</code> file, and unpacked trees under <code>public/demos/imscc-unpacked/</code> power
          the <a href={IMSCC_VIEWER_PATH}>IMS CC viewer</a>.
        </li>
        <li>
          GitHub Pages: slides deploy from the main branch of the AIMA repo; demo URLs assume the CastaliaInstitute org
          Pages site.
        </li>
        <li>
          SAMWISE and BEATRICE: SAMWISE is primarily local curriculum-server tooling; BEATRICE uses instructor notes and
          optional Supabase functions—see the linked docs above.
        </li>
      </ul>

      <div slot="secondary">
        <section class="populi-demo__panel">
          <div class="populi-demo__panel-head">
            <h2 class="populi-demo__panel-title">Schedule</h2>
          </div>
          <p class="populi-demo__panel-body populi-demo__panel-body--empty">
            There are no scheduled events in the next seven days.
          </p>
        </section>
        <section class="populi-demo__panel">
          <div class="populi-demo__panel-head">
            <h2 class="populi-demo__panel-title">My Discussions</h2>
          </div>
          <p class="populi-demo__panel-body populi-demo__panel-body--empty">
            There are no recent discussion updates.
          </p>
        </section>
      </div>
    </PopuliDemoShell>
  </main>
</BaseLayout>
