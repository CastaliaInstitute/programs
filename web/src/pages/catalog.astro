---
import BaseLayout from '../layouts/BaseLayout.astro'
import AimaVariantCatalogTable from '../components/AimaVariantCatalogTable.astro'
import { programOfferings } from '../lib/programs'
import type { CatalogCourseDetail } from '../lib/catalog-courses'
import { isPurchaseAvailableFrom } from '../lib/purchase-gate'
import { CASTALIA_LMS_URL, castaliaLmsCatalogCourseUrl, resolveStripePaymentLinkAimaBasic } from '../lib/site-links'

const aimaBasicStripe = resolveStripePaymentLinkAimaBasic()
---

<BaseLayout
  title="Programs Catalog"
  description="Browse Castalia graduate AI courses, certificates, and AIMA 5001 variants—collapsible tables with demos, IMS CC, and purchase links."
>
  <main class="programs-page section catalog-page">
    <div class="section__intro">
      <span class="eyebrow">Programs Catalog</span>
      <h1>Licensable courses and products</h1>
      <p>
        Expand each section for course tables. AINS rows include dates, links to a per-course overview (description +
        syllabus), and Castalia LMS. AIMA 5001 adds a feature matrix (IMS CC, slides, assignments, MP3, MP4, dialogic,
        GitHub Classroom, Google Classroom), demos, cartridge download, and purchase actions per variant when released.
      </p>
      <p class="catalog-path">
        <a class="button button--primary" href="/purchase">Purchase hub</a>
        <a class="button button--secondary" href="/catalog/imscc-viewer">IMS CC viewer</a>
        <a
          class="button button--ghost"
          href={CASTALIA_LMS_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          Castalia LMS
        </a>
      </p>
    </div>

    <div class="catalog-disclosure-stack">
      {
        programOfferings.map((program, programIndex) => (
          <details class="catalog-disclosure" open={programIndex === 0}>
            <summary class="catalog-disclosure__summary">
              <span class="catalog-disclosure__title">{program.title}</span>
              <span class="catalog-disclosure__chips">
                <span class="chip">{program.format}</span>
                <span class="chip chip--muted">{program.modality}</span>
              </span>
            </summary>
            <div class="catalog-disclosure__body">
              <p class="catalog-disclosure__lede">{program.summary}</p>

              <dl class="catalog-meta-grid">
                <div>
                  <dt>Audience</dt>
                  <dd>{program.audience}</dd>
                </div>
                {program.credits && (
                  <div>
                    <dt>Credits</dt>
                    <dd>{program.credits}</dd>
                  </div>
                )}
                <div>
                  <dt>Duration</dt>
                  <dd>{program.duration}</dd>
                </div>
                <div>
                  <dt>Implementation</dt>
                  <dd>{program.implementation}</dd>
                </div>
              </dl>

              {program.detailHref && (
                <p class="catalog-disclosure__detail">
                  <a class="button button--secondary" href={program.detailHref}>
                    {program.slug === 'aima' && program.deliverableDemos?.length
                      ? `Full ${program.deliverableDemos.length}-variant product page`
                      : 'View details'}
                  </a>
                </p>
              )}

              {program.slug === 'aima' && program.deliverableDemos && program.deliverableDemos.length > 0 && (
                <div class="catalog-table-section">
                  <h3 class="catalog-table-section__title">AIMA 5001 variants</h3>
                  <AimaVariantCatalogTable demos={program.deliverableDemos} aimaBasicStripe={aimaBasicStripe} />
                </div>
              )}

              {program.curriculumColleges && program.curriculumColleges.length > 0 && (
                <div class="catalog-college-wrap">
                  {program.curriculumColleges.map((college) => (
                    <section class="catalog-college">
                      <h3 class="catalog-college__head">
                        <span class="chip chip--college">{college.code}</span>
                        {college.title}
                      </h3>
                      {college.blocks.map((block, blockIndex) => {
                        const first = block.courses[0]
                        const isStructured =
                          block.courses.length > 0 &&
                          typeof first === 'object' &&
                          first !== null &&
                          'routeSlug' in first
                        const isHighlightBlock = program.slug === 'aima' && block.title.includes('Curriculum & delivery')
                        const subOpen = program.slug === 'aima' ? isHighlightBlock : blockIndex === 0
                        return (
                          <details class="catalog-subdisclosure" open={subOpen}>
                            <summary class="catalog-subdisclosure__summary">{block.title}</summary>
                            <div class="catalog-subdisclosure__body">
                              {!isStructured ? (
                                <ul class="list catalog-highlight-list">
                                  {(block.courses as string[]).map((line) => (
                                    <li>{line}</li>
                                  ))}
                                </ul>
                              ) : (
                                <div class="catalog-table-scroll">
                                  <table class="catalog-table catalog-table--course-list">
                                    <thead>
                                      <tr>
                                        <th scope="col">Code</th>
                                        <th scope="col">Course</th>
                                        <th scope="col">Date</th>
                                        <th scope="col">Status</th>
                                        <th scope="col">LMS</th>
                                        <th scope="col">Overview</th>
                                        <th scope="col">Buy</th>
                                      </tr>
                                    </thead>
                                    <tbody>
                                      {(block.courses as CatalogCourseDetail[]).map((c) => (
                                        <tr>
                                          <td>
                                            <code class="catalog-code">{c.code}</code>
                                          </td>
                                          <td>
                                            <a class="catalog-table__course-link" href={`/catalog/courses/${c.routeSlug}`}>
                                              {c.title}
                                            </a>
                                          </td>
                                          <td class="catalog-table__date">{c.dateLabel}</td>
                                          <td class="catalog-table__status">{block.statusExpected ?? '—'}</td>
                                          <td>
                                            <a
                                              class="button button--table button--table-ghost"
                                              href={castaliaLmsCatalogCourseUrl(c)}
                                              target="_blank"
                                              rel="noopener noreferrer"
                                            >
                                              LMS
                                            </a>
                                          </td>
                                          <td>
                                            <a class="button button--table" href={`/catalog/courses/${c.routeSlug}`}>
                                              Details
                                            </a>
                                          </td>
                                          <td>
                                            {isPurchaseAvailableFrom(block.purchaseAvailableFrom) ? (
                                              <a class="button button--table button--table-buy" href="/purchase">
                                                Purchase
                                              </a>
                                            ) : (
                                              <span class="catalog-table__na">Not for sale yet</span>
                                            )}
                                          </td>
                                        </tr>
                                      ))}
                                    </tbody>
                                  </table>
                                </div>
                              )}
                            </div>
                          </details>
                        )
                      })}
                    </section>
                  ))}
                </div>
              )}

              {!program.curriculumColleges?.length && program.curriculumHighlights && (
                <div class="catalog-table-section">
                  <h3 class="catalog-table-section__title">Highlights</h3>
                  <ul class="list">
                    {program.curriculumHighlights.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ul>
                </div>
              )}

              <div class="catalog-outcomes">
                <h3 class="catalog-table-section__title">What institutions get</h3>
                <ul class="list">
                  {program.outcomes.map((o) => (
                    <li>{o}</li>
                  ))}
                </ul>
                <h3 class="catalog-table-section__title">Best fit</h3>
                <ul class="list">
                  {program.institutionFit.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              </div>
            </div>
          </details>
        ))
      }
    </div>

    <section class="section section--tight">
      <div class="section__intro">
        <h2>Common buying structures</h2>
        <p>
          The same courseware can be licensed in different shapes depending on your catalog strategy and launch
          timeline.
        </p>
      </div>
      <div class="grid grid--cards">
        <article class="card">
          <h3>Full graduate AI stack</h3>
          <p>
            Best for institutions that want the complete reference core, capstone, and specialization clusters licensed
            together.
          </p>
        </article>
        <article class="card">
          <h3>Certificate portfolio</h3>
          <p>Best for institutions that want stackable AI certificates drawn from the core and Local AI course set.</p>
        </article>
        <article class="card">
          <h3>Specialization-first pilot</h3>
          <p>
            Best for teams starting with a healthcare, business, cybersecurity, or robotics AI concentration before full
            rollout.
          </p>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>
