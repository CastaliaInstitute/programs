---
import '../styles/global.css'
import ProgramsShell from '../components/ProgramsShell'
import { pageContractForSitePath, pageMetaFromContract, normalizeSitePath } from '@castalia/platform'
import { PROGRAMS_PUBLIC_PATHS, PROGRAMS_SITE } from '../lib/contracts'

interface Props {
  title: string
  description?: string
  isHomePage?: boolean
}

const { title, description, isHomePage: isHomePageProp } = Astro.props
const path = Astro.url.pathname
const contract = pageContractForSitePath(path, {
  site: PROGRAMS_SITE,
  title,
  extraPublicPaths: [...PROGRAMS_PUBLIC_PATHS],
})
const meta = pageMetaFromContract(contract, path)
const pageTitle = contract.title
const desc =
  description ??
  'Licensable AI graduate programs and certificates for universities, colleges, and workforce partners.'
const isHomePage = isHomePageProp ?? normalizeSitePath(path) === '/'
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={desc} />
    <meta name="robots" content={meta.robots} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <ProgramsShell client:load isHomePage={isHomePage}>
      <slot />
    </ProgramsShell>
  </body>
</html>
